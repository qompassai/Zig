# .gitignore — Qompass AI Zig template (broad starter).
# Delete the sections you do not need.

# --- OS / editor ---
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.vscode/
.idea/
*.iml

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Rust ---
target/
Cargo.lock
**/*.rs.bk

# --- Go ---
bin/
*.exe

# --- Lua ---
luac.out

# --- Zig ---
zig-out/
zig-cache/
.zig-cache/

# --- Mojo ---
__mojocache__/
*.mojopkg

# --- Java / JVM ---
*.class
*.jar
*.war
.gradle/
out/

# --- Node ---
node_modules/

# --- Nix ---
result
result-*

# --- C / C++ ---
*.o
*.a
*.so

# --- LaTeX ---
*.aux
*.log
*.out
*.toc
*.pdf

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# --- Containers ---
*.tar

# --- Misc ---
*.log
*.tmp
.env
